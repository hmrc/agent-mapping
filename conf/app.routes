# microservice specific routes

PUT           /mappings/arn/:arn                                               @uk.gov.hmrc.agentmapping.controller.MappingController.createMapping(arn: Arn)
PUT           /mappings/auto-map/arn/:arn                                      uk.gov.hmrc.agentmapping.controller.MappingController.autoMapEnrolments(arn: Arn)

GET           /mappings/eligibility                                            @uk.gov.hmrc.agentmapping.controller.MappingController.hasEligibleEnrolments()

GET           /client-count                                                    @uk.gov.hmrc.agentmapping.controller.MappingController.getClientCount

GET           /mappings/sa/:arn                                                @uk.gov.hmrc.agentmapping.controller.MappingController.findSaMappings(arn: Arn)
GET           /mappings/agentcode/:arn                                         @uk.gov.hmrc.agentmapping.controller.MappingController.findAgentCodeMappings(arn: Arn)
GET           /mappings/arn/:arn                                               @uk.gov.hmrc.agentmapping.controller.MappingLookupController.mappingsByArn(arn: Arn)
GET           /mappings/key/:key/code/:code                                    @uk.gov.hmrc.agentmapping.controller.MappingLookupController.mappingsByKeyAndAgentCode(key: String, code: String)
GET           /mappings/code/:code                                             @uk.gov.hmrc.agentmapping.controller.MappingLookupController.mappingsByAgentCode(code: String)

# supported keys: char,gts,mgd,novrn,ct,paye,sdlt
GET           /mappings/key/:key/arn/:arn                                      @uk.gov.hmrc.agentmapping.controller.MappingController.findMappings(key: String, arn: Arn)

DELETE        /mappings/service/:enrolmentService/value/:value/arn/:arn        @uk.gov.hmrc.agentmapping.controller.MappingController.deleteMapping(enrolmentService: LegacyAgentEnrolmentType, value: String, arn: Arn)

GET           /mapping-status/service/:enrolmentService/value/:value           @uk.gov.hmrc.agentmapping.controller.MappingStatusController.mappingStatus(enrolmentService: LegacyAgentEnrolmentType, value: String)
